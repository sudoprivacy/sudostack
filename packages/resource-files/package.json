{
  "name": "@sudo/resource-files",
  "version": "0.1.0",
  "description": "Shared resource archive and directory I/O with bounded paths, payloads and owner permissions.",
  "type": "module",
  "engines": { "node": ">=22.21.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudoprivacy/sudostack.git",
    "directory": "packages/resource-files"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": { "jszip": "3.10.1" },
  "devDependencies": { "@types/node": "22.20.3", "tsx": "4.23.13", "typescript": "5.9.3" }
}
