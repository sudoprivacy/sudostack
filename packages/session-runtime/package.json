{
  "name": "@sudo/session-runtime",
  "version": "0.1.0",
  "description": "Owner-authenticated Nexus controller connections and credential renewal.",
  "type": "module",
  "engines": { "node": ">=22.21.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudoprivacy/sudostack.git",
    "directory": "packages/session-runtime"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./controller-rpc": { "types": "./dist/controllerRpc.d.ts", "import": "./dist/controllerRpc.js" }
  },
  "bin": { "sudo-session-runtime-controller": "./bin/controller-rpc.mjs" },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nexus-ai-fs/vfs-client": "https://sudowork-runtime-1309794936.cos.accelerate.myqcloud.com/nexus-vfs/clients/node/0.8.1/nexus-ai-fs-vfs-client-0.8.1.tgz"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@types/node": "22.20.3",
    "node-forge": "1.3.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
