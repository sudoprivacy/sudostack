{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sudo.dev/schemas/common/v1/resource-ref.schema.json",
  "title": "ResourceRef",
  "type": "object",
  "required": ["api_version", "kind", "zone_id", "path"],
  "additionalProperties": true,
  "properties": {
    "api_version": {
      "const": "common.sudo.dev/v1"
    },
    "kind": {
      "const": "ResourceRef"
    },
    "zone_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+.-]*:[A-Za-z0-9._~+/=-]+$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[^\\s/]+/[^\\s]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
