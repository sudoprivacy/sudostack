{
  "$id": "https://contracts.sudo.dev/schemas/common/v1/resource-ref.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "common.sudo.dev/v1"
    },
    "digest": {
      "pattern": "^[a-z0-9][a-z0-9+.-]*:[A-Za-z0-9._~+/=-]+$",
      "type": "string"
    },
    "kind": {
      "const": "ResourceRef"
    },
    "media_type": {
      "pattern": "^[^\\s/]+/[^\\s]+$",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "pattern": "^/",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "zone_id": {
      "maxLength": 63,
      "minLength": 3,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "kind",
    "zone_id",
    "path"
  ],
  "title": "ResourceRef",
  "type": "object"
}
